APP_ENV=development
APP_DEBUG=false
APP_NAME=GNF-Token API

# Format : postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://gnftoken:CHANGE_ME@localhost:5432/gnf_db

SECRET_KEY=GENERATE_64_CHARS
JWT_SECRET_KEY=GENERATE_64_CHARS

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

REDIS_URL=

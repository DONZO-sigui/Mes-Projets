# ════════════════════════════════════════════════════════════
#  GNF-Token — Variables d'environnement
#  COPIER ce fichier en .env et remplir les vraies valeurs.
#  NE JAMAIS commiter le fichier .env
# ════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_NAME=GNF-Token

# ─── Base de données PostgreSQL ───────────────────────────────
# Format : postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=

# ─── Sécurité ─────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# ─── Tokens ───────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────
# Origines autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Redis (optionnel — Celery, rate limiting, sessions) ──────
REDIS_URL=

# ─── Email (optionnel — notifications) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Upload / Storage (optionnel — KYC documents) ─────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tableau de bord - Gestion des absences</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<div class="app-container">
    <%- include('partials/sidebar', { activePage: 'accueil' }) %>

    <main class="app-main">
        <%- include('partials/topbar', { currentUser: currentUser }) %>

        <div class="content-wrapper">
            <% if (typeof flashMessages !== 'undefined' && flashMessages.success && flashMessages.success.length) { %>
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 0.5rem;">
                    <i class="bi bi-check-circle-fill me-2"></i> <%= flashMessages.success[0] %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (typeof flashMessages !== 'undefined' && flashMessages.error && flashMessages.error.length) { %>
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 0.5rem;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= flashMessages.error[0] %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <div class="d-flex align-items-center mb-4">
                <div>
                    <h1 class="h4 fw-bold mb-1" style="color: var(--text-main);">
                        <%= currentUser && currentUser.role === 'directeur' ? 'Demandes en attente' : 'Déclaration d\'absence' %>
                    </h1>
                    <p class="text-muted mb-0" style="font-size: 0.875rem;">
                        <%= currentUser && currentUser.role === 'directeur' ? 'Gérez et validez les absences déclarées par les étudiants.' : 'Remplissez le formulaire ci-dessous pour signaler une absence.' %>
                    </p>
                </div>
            </div>

            <div class="row">
                <% if (currentUser && currentUser.role === 'directeur') { %>
                    <!-- Espace Directeur -->
                    <div class="col-12">
                        <div class="enterprise-card">
                            <div class="card-header-custom d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 fw-semibold" style="font-size: 1rem;">File d'attente</h5>
                                <span class="badge bg-primary rounded-pill"><%= typeof pendingAbsences !== 'undefined' ? pendingAbsences.length : 0 %> demandes</span>
                            </div>
                            
                            <% if (typeof pendingAbsences !== 'undefined' && pendingAbsences.length > 0) { %>
                                <div class="table-responsive">
                                    <table class="table table-enterprise mb-0">
                                        <thead>
                                            <tr>
                                                <th>Étudiant</th>
                                                <th>Date</th>
                                                <th>Motif</th>
                                                <th>Pièce jointe</th>
                                                <th class="text-end">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% pendingAbsences.forEach(absence => { %>
                                                <tr>
                                                    <td>
                                                        <div class="fw-semibold"><%= absence.nom %></div>
                                                        <div class="text-muted" style="font-size: 0.75rem;"><%= absence.niveau_etude || 'N/A' %></div>
                                                    </td>
                                                    <td><%= absence.date_absence %></td>
                                                    <td style="max-width: 200px;" class="text-truncate" title="<%= absence.motif %>">
                                                        <%= absence.motif || '—' %>
                                                    </td>
                                                    <td>
                                                        <% if (absence.justificatif) { %>
                                                            <a href="/uploads/<%= absence.justificatif %>" target="_blank" class="text-primary text-decoration-none" style="font-size: 0.875rem;">
                                                                <i class="bi bi-paperclip"></i> Justificatif
                                                            </a>
                                                        <% } else { %>
                                                            <span class="text-muted">—</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-end">
                                                        <div class="d-flex justify-content-end gap-2">
                                                            <form action="/absence/valider/<%= absence.id %>" method="POST" class="m-0">
                                                                <button type="submit" class="btn btn-sm btn-primary">
                                                                    Valider
                                                                </button>
                                                            </form>
                                                            <form action="/absence/refuser/<%= absence.id %>" method="POST" class="m-0" onsubmit="return confirm('Êtes-vous sûr de vouloir refuser cette demande ?');">
                                                                <button type="submit" class="btn btn-sm btn-danger">
                                                                    Refuser
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="card-body-custom text-center py-5">
                                    <i class="bi bi-check2-circle text-muted" style="font-size: 2.5rem;"></i>
                                    <h6 class="mt-3 text-muted fw-semibold">Aucune demande</h6>
                                    <p class="text-muted small mb-0">Toutes les absences ont été traitées.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Espace Étudiant -->
                    <div class="col-12 col-xl-8">
                        <div class="enterprise-card">
                            <div class="card-header-custom">
                                <h5 class="mb-0 fw-semibold" style="font-size: 1rem;">Nouveau dossier</h5>
                            </div>
                            <div class="card-body-custom">
                                <form action="/absence" method="POST" enctype="multipart/form-data">
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-4">
                                            <label for="nom" class="form-label">Nom complet</label>
                                            <input id="nom" type="text" name="nom" class="form-control" placeholder="Entrez votre nom" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="matricule" class="form-label">Matricule</label>
                                            <input id="matricule" type="text" name="matricule" class="form-control" placeholder="Ex: ETU00123" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="filiere" class="form-label">Filière</label>
                                            <select id="filiere" name="filiere" class="form-select" required>
                                                <option value="" disabled selected>Sélectionnez une filière</option>
                                                <option value="NTIC">NTIC</option>
                                                <option value="DL">DL</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row g-4 mb-4">
                                        <div class="col-md-6">
                                            <label for="niveau_etude" class="form-label">Niveau d'étude</label>
                                            <select id="niveau_etude" name="niveau_etude" class="form-select" required>
                                                <option value="" disabled selected>Sélectionnez un niveau</option>
                                                <option value="Licence 1">Licence 1</option>
                                                <option value="Licence 2">Licence 2</option>
                                                <option value="Licence 3">Licence 3</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="date_absence" class="form-label">Date de l'absence</label>
                                            <input id="date_absence" type="date" name="date_absence" class="form-control" required>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label for="motif" class="form-label">Motif</label>
                                        <textarea id="motif" name="motif" class="form-control" rows="3" placeholder="Veuillez détailler la raison de l'absence..." required></textarea>
                                    </div>

                                    <div class="mb-5">
                                        <label for="justificatif" class="form-label">Pièce justificative <span class="text-muted fw-normal">(Optionnel)</span></label>
                                        <input id="justificatif" type="file" name="justificatif" class="form-control">
                                    </div>

                                    <div class="d-flex justify-content-end">
                                        <button type="submit" class="btn btn-primary px-4">
                                            <i class="bi bi-send me-1"></i> Soumettre
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Historique - Gestion des absences</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<div class="app-container">
    <%- include('partials/sidebar', { activePage: 'historique' }) %>

    <main class="app-main">
        <%- include('partials/topbar', { currentUser: currentUser }) %>

        <div class="content-wrapper">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h4 fw-bold mb-1" style="color: var(--text-main);">Historique des enregistrements</h1>
                    <p class="text-muted mb-0" style="font-size: 0.875rem;">
                        <%= currentUser && currentUser.role === 'directeur' ? 'Consultez la base globale des absences validées et en attente.' : 'Suivez l\'état d\'avancement de vos demandes.' %>
                    </p>
                </div>
                <div>
                    <a href="/" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> 
                        <%= currentUser && currentUser.role === 'directeur' ? 'Aller aux validations' : 'Nouvelle déclaration' %>
                    </a>
                </div>
            </div>

            <% if (typeof selectedAbsence !== 'undefined' && selectedAbsence) { %>
                <div class="enterprise-card mb-5 shadow-sm border-primary" style="border-width: 2px;">
                    <div class="card-header-custom d-flex justify-content-between align-items-center bg-primary bg-opacity-10">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-white p-2 rounded shadow-sm text-primary">
                                <i class="bi bi-file-text fs-4"></i>
                            </div>
                            <div>
                                <h4 class="mb-0 fw-bold" style="color: var(--text-main);">Dossier d'absence #<%= selectedAbsence.id %></h4>
                                <span class="text-muted small">Soumis le <%= selectedAbsence.date_absence %></span>
                            </div>
                        </div>
                        <a href="/historique" class="btn btn-outline-secondary btn-sm rounded-circle p-2" aria-label="Fermer" title="Fermer les détails">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                    <div class="card-body-custom p-4">
                        <div class="row">
                            <!-- Colonne Gauche : Étudiant et Motif -->
                            <div class="col-md-8 border-end pe-md-4">
                                <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">Informations de l'étudiant</h6>
                                <div class="d-flex align-items-center mb-4 p-3 bg-light rounded-3 border">
                                    <div class="me-3 bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="bi bi-person-fill fs-4 text-secondary"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-0 fw-bold"><%= selectedAbsence.nom %></h5>
                                        <span class="text-muted small">Matricule : <%= selectedAbsence.matricule || 'Non renseigné' %></span>
                                        <br>
                                        <span class="text-muted small">Filière : <%= selectedAbsence.filiere || 'Non renseignée' %></span>
                                    </div>
                                    <div class="ms-auto text-end">
                                        <span class="badge bg-dark rounded-pill px-3 py-2"><%= selectedAbsence.niveau_etude || 'Niveau inconnu' %></span>
                                    </div>
                                </div>

                                <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">Motif de l'absence</h6>
                                <div class="p-4 bg-white rounded-3 border mb-4 position-relative">
                                    <i class="bi bi-quote position-absolute text-light" style="font-size: 4rem; top: -10px; left: 10px; z-index: 0;"></i>
                                    <p class="mb-0 position-relative" style="z-index: 1; font-size: 0.95rem; line-height: 1.6; color: #334155;">
                                        <%= selectedAbsence.motif || 'L\'étudiant n\'a fourni aucune explication.' %>
                                    </p>
                                </div>
                            </div>

                            <!-- Colonne Droite : Métadonnées et Actions -->
                            <div class="col-md-4 ps-md-4">
                                <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">Statut du dossier</h6>
                                <div class="mb-4">
                                    <div class="p-3 border rounded-3 d-flex align-items-center justify-content-center <%= selectedAbsence.statut === 'validee' ? 'bg-success bg-opacity-10 border-success' : (selectedAbsence.statut === 'refusee' ? 'bg-danger bg-opacity-10 border-danger' : 'bg-warning bg-opacity-10 border-warning') %>">
                                        <% if (selectedAbsence.statut === 'validee') { %>
                                            <i class="bi bi-check-circle-fill text-success fs-4 me-2"></i>
                                            <span class="fw-bold text-success fs-5">Demande Validée</span>
                                        <% } else if (selectedAbsence.statut === 'refusee') { %>
                                            <i class="bi bi-x-circle-fill text-danger fs-4 me-2"></i>
                                            <span class="fw-bold text-danger fs-5">Demande Refusée</span>
                                        <% } else { %>
                                            <i class="bi bi-hourglass-split text-warning fs-4 me-2"></i>
                                            <span class="fw-bold text-warning fs-5" style="color: #92400e !important;">En Attente</span>
                                        <% } %>
                                    </div>
                                </div>

                                <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">Pièce Jointe</h6>
                                <div class="mb-4">
                                    <% if (selectedAbsence.justificatif) { %>
                                        <a href="/uploads/<%= selectedAbsence.justificatif %>" target="_blank" class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-2 py-2">
                                            <i class="bi bi-paperclip fs-5"></i> Consulter le justificatif
                                        </a>
                                    <% } else { %>
                                        <div class="p-3 bg-light rounded text-center text-muted border border-dashed">
                                            <i class="bi bi-file-earmark-x fs-4 d-block mb-1"></i>
                                            <small>Aucun fichier joint</small>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Actions directes pour le directeur -->
                                <% if (currentUser && currentUser.role === 'directeur' && selectedAbsence.statut === 'en_attente') { %>
                                    <hr>
                                    <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">Actions Rapides</h6>
                                    <form action="/absence/valider/<%= selectedAbsence.id %>" method="POST" class="mb-2">
                                        <button type="submit" class="btn btn-success w-100 fw-bold py-2 shadow-sm">
                                            <i class="bi bi-check2-all me-1"></i> Valider cette absence
                                        </button>
                                    </form>
                                    <form action="/absence/refuser/<%= selectedAbsence.id %>" method="POST" class="mb-2" onsubmit="return confirm('Êtes-vous sûr de vouloir refuser cette demande ?');">
                                        <button type="submit" class="btn btn-danger w-100 fw-bold py-2 shadow-sm">
                                            <i class="bi bi-x-circle me-1"></i> Refuser cette absence
                                        </button>
                                    </form>
                                    <form action="/absence/supprimer/<%= selectedAbsence.id %>" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette demande ?');">
                                        <button type="submit" class="btn btn-outline-danger w-100 fw-bold py-2">
                                            <i class="bi bi-trash me-1"></i> Supprimer
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

            <div class="enterprise-card overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-enterprise">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nom</th>
                                <th>Niveau</th>
                                <th>Date</th>
                                <th>Motif</th>
                                <th>Statut</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof absences !== 'undefined' && absences.length > 0) { %>
                                <% absences.forEach(absence => { %>
                                    <tr>
                                        <td class="text-muted">#<%= absence.id %></td>
                                        <td class="fw-medium"><%= absence.nom %></td>
                                        <td><span class="text-muted"><%= absence.niveau_etude || '—' %></span></td>
                                        <td><%= absence.date_absence %></td>
                                        <td class="text-truncate" style="max-width: 200px;" title="<%= absence.motif %>">
                                            <%= absence.motif || '—' %>
                                        </td>
                                        <td>
                                            <span class="status-badge <%= absence.statut === 'validee' ? 'status-validee' : (absence.statut === 'refusee' ? 'status-refusee' : 'status-en_attente') %>">
                                                <%= absence.statut === 'validee' ? 'Validée' : (absence.statut === 'refusee' ? 'Refusée' : 'En attente') %>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a href="/historique?id=<%= absence.id %>" class="btn btn-sm btn-outline-secondary" style="font-size: 0.75rem;">
                                                    <i class="bi bi-eye"></i> Détails
                                                </a>
                                                <form action="/absence/supprimer/<%= absence.id %>" method="POST" class="m-0" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette demande ?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 0.75rem;">
                                                        <i class="bi bi-trash"></i> Supprimer
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="bi bi-inbox fs-2"></i>
                                            <p class="mt-2 mb-0 fw-medium">Aucune donnée trouvée</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

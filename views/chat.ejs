<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Assistante IA - Gestion des absences</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<div class="app-container">
    <%- include('partials/sidebar', { activePage: 'chat' }) %>

    <main class="app-main">
        <%- include('partials/topbar', { currentUser: currentUser }) %>

        <div class="content-wrapper d-flex flex-column h-100" style="padding-bottom: 0;">
            <div class="mb-4">
                <h1 class="h4 fw-bold mb-1" style="color: var(--text-main);">Assistante Support</h1>
                <p class="text-muted mb-0" style="font-size: 0.875rem;">
                    Un problème ou une question sur la procédure ? Posez votre question ici.
                </p>
            </div>

            <div class="enterprise-card chat-container flex-grow-1 mb-4">
                <div class="chat-window" id="chat-window">
                    <% if (typeof chatHistory !== 'undefined' && chatHistory.length > 0) { %>
                        <% chatHistory.forEach(msg => { %>
                            <div class="message <%= msg.sender === 'user' ? 'user-message' : 'bot-message' %>">
                                <%= msg.message %>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="message bot-message">
                            Bonjour ! Je suis l'assistante support de la plateforme. Comment puis-je vous aider aujourd'hui ?
                        </div>
                    <% } %>
                </div>

                <div class="chat-input-area">
                    <form id="chat-form" class="m-0 d-flex gap-3">
                        <input id="message-input" type="text" class="form-control" placeholder="Taper votre message ici..." autocomplete="off" required style="border-radius: 9999px; padding-left: 1.25rem;">
                        <button type="submit" class="btn btn-primary" style="border-radius: 9999px; padding-left: 1.5rem; padding-right: 1.5rem;">
                            <i class="bi bi-send-fill me-1"></i> Envoyer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/chat.js"></script>
</body>
</html>

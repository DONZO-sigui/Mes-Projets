<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <!-- Outer ring -->
  <circle cx="100" cy="100" r="96" fill="#0c2461" stroke="#c9a227" stroke-width="3"/>
  <circle cx="100" cy="100" r="88" fill="none" stroke="#c9a227" stroke-width="1"/>

  <!-- Circular text path -->
  <defs>
    <path id="topArc"
      d="M 18,100 a82,82 0 1,1 164,0"
      fill="none"/>
    <path id="botArc"
      d="M 32,120 a74,74 0 0,0 136,0"
      fill="none"/>
  </defs>
  <text font-family="'Georgia',serif" font-size="9" fill="#c9a227" font-weight="bold" letter-spacing="1.8">
    <textPath href="#topArc" startOffset="6%">MINISTÈRE DE L'ENSEIGNEMENT SUPÉRIEUR</textPath>
  </text>
  <text font-family="'Georgia',serif" font-size="8.5" fill="#c9a227" letter-spacing="1.5">
    <textPath href="#botArc" startOffset="8%">DE LA RECHERCHE SCIENTIFIQUE ET DE L'INNOVATION</textPath>
  </text>

  <!-- Shield background -->
  <path d="M100 38 L130 52 L130 90 Q130 118 100 132 Q70 118 70 90 L70 52 Z"
        fill="#1a3a6b" stroke="#c9a227" stroke-width="2"/>

  <!-- Guinea flag stripes inside shield -->
  <clipPath id="shieldClip">
    <path d="M100 38 L130 52 L130 90 Q130 118 100 132 Q70 118 70 90 L70 52 Z"/>
  </clipPath>
  <rect x="70" y="38" width="20" height="96" fill="#CE1126" clip-path="url(#shieldClip)"/>
  <rect x="90" y="38" width="20" height="96" fill="#FCD116" clip-path="url(#shieldClip)"/>
  <rect x="110" y="38" width="20" height="96" fill="#009460" clip-path="url(#shieldClip)"/>

  <!-- Olive branch left -->
  <g transform="translate(72,92) rotate(-30)" stroke="#c9a227" stroke-width="1.2" fill="none">
    <line x1="0" y1="0" x2="0" y2="-22"/>
    <ellipse cx="-4" cy="-8"  rx="4" ry="2.5" fill="#c9a227" transform="rotate(-40,-4,-8)"/>
    <ellipse cx="-3" cy="-15" rx="4" ry="2.5" fill="#c9a227" transform="rotate(-30,-3,-15)"/>
  </g>
  <!-- Olive branch right -->
  <g transform="translate(128,92) rotate(30) scale(-1,1)" stroke="#c9a227" stroke-width="1.2" fill="none">
    <line x1="0" y1="0" x2="0" y2="-22"/>
    <ellipse cx="-4" cy="-8"  rx="4" ry="2.5" fill="#c9a227" transform="rotate(-40,-4,-8)"/>
    <ellipse cx="-3" cy="-15" rx="4" ry="2.5" fill="#c9a227" transform="rotate(-30,-3,-15)"/>
  </g>

  <!-- Stars (Guinean emblem style) -->
  <g fill="#c9a227">
    <polygon points="100,134 102,140 108,140 103,144 105,150 100,146 95,150 97,144 92,140 98,140" transform="scale(0.7) translate(43,-10)"/>
  </g>

  <!-- MESRSI label box -->
  <rect x="72" y="148" width="56" height="16" rx="3" fill="#c9a227"/>
  <text x="100" y="160" text-anchor="middle" font-family="'Arial',sans-serif" font-size="9.5"
        font-weight="bold" fill="#0c2461" letter-spacing="2">MESRSI</text>

  <!-- Stars top corners -->
  <text x="34" y="58" font-size="10" fill="#c9a227" text-anchor="middle">★</text>
  <text x="166" y="58" font-size="10" fill="#c9a227" text-anchor="middle">★</text>
  <text x="100" y="30" font-size="8" fill="#c9a227" text-anchor="middle">✦</text>
</svg>
